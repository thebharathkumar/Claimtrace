# LLM access. When unset, the pipeline runs in deterministic offline mode:
# claims are extracted with grounded pattern matching over the real chunks,
# so the demo works end to end with no key and no invented data.
ANTHROPIC_API_KEY=

# Claude model used for extraction and brief writing in LLM mode.
CLAIMTRACE_MODEL=claude-opus-4-8

# Force offline mode even if a key is present.
CLAIMTRACE_OFFLINE=0

# HMAC key for the tamper-evident audit chain. Use a real secret in production.
CLAIMTRACE_AUDIT_KEY=claimtrace-dev-key

# SQLite database path.
CLAIMTRACE_DB=claimtrace.db

# agent-triage OTLP receiver. Start it with:
#   uvicorn triage.server:app --port 8765
AGENT_TRIAGE_ENDPOINT=http://127.0.0.1:8765/otlp/v1/traces

# Link shown in the viewer for the full agent-triage dashboard.
AGENT_TRIAGE_DASHBOARD=http://127.0.0.1:8765/

# Enable the tamper demo endpoints used by the viewer's tamper button.
CLAIMTRACE_DEMO=1
